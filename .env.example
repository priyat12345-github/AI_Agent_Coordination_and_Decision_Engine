# ─── LLM Provider ────────────────────────────────────────────────────────────
# Choose one: openai | google | anthropic
LLM_PROVIDER=openai

# ─── API Keys (fill in only the one you're using) ────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# ─── Model Selection ─────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-1.5-pro
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── App Config ──────────────────────────────────────────────────────────────
MAX_ITERATIONS=5
TEMPERATURE=0.3
